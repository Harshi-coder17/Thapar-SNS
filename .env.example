# Copy to .env for local development. Never commit .env.
# Values below match docker-compose.yml and are for local use only.

DATABASE_URL=postgresql://thapar_sns:local_dev_only@127.0.0.1:55432/thapar_sns

# Local S3 (Garage). The access key and secret are generated by `npm run setup:local`
# into docker/garage/credentials.local.env (gitignored).
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=thapar-sns-dev

# Authentication (production identity slice; see docs/auth/google-oauth-setup.md).
# Leave empty until the owner creates the Google OAuth client. Never commit real values.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# FR-AUTH-1: only @thapar.edu accounts (owner confirmed 2026-10-24, OI-51).
AUTH_ALLOWED_EMAIL_DOMAIN=thapar.edu
# Optional, OI-09: comma-separated @thapar.edu addresses that receive the ADMIN role when they sign in.
ADMIN_EMAILS=

# Background service (npm run service). OI-63, 2026-10-26: outside production, scheduled jobs that
# delete records are off by default (currently stories.cleanup), so development data is never removed.
# Set a comma-separated list to choose exactly which jobs are off ("none" runs every job, as production does).
# SERVICE_DISABLED_JOBS=stories.cleanup
# Extra browser origins allowed by the local bucket's CORS rule, besides BETTER_AUTH_URL (comma-separated).
# STORAGE_CORS_EXTRA_ORIGINS=
# Key prefix on the shared Valkey for realtime; lets several local services share one Valkey.
# REALTIME_KEY_PREFIX=rt:
