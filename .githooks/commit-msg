#!/bin/sh
# Rejects commit messages containing an em-dash (U+2014, UTF-8 bytes E2 80 94). CLAUDE.md rule 10.
# Plain shell so it works without Node on PATH. Enabled with: git config core.hooksPath .githooks
EM_DASH=$(printf '\342\200\224')
if grep -v '^#' "$1" | grep -q "$EM_DASH"; then
  echo "commit-msg: em-dash characters are not allowed. Use a colon, comma, semicolon or parentheses." >&2
  exit 1
fi
exit 0
