# Copy to .env for local development. Never commit .env.
# Values below match docker-compose.yml and are for local use only.

DATABASE_URL=postgresql://thapar_sns:local_dev_only@127.0.0.1:55432/thapar_sns

# Local S3 (Garage). The access key and secret are generated by `npm run setup:local`
# into docker/garage/credentials.local.env (gitignored).
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=thapar-sns-dev
